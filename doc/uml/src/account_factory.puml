@startuml account_factory
title Account Provider Factory
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "agent.proto (Protobuf messages)" as proto {
  enum ApiFormat {
    API_FORMAT_UNSPECIFIED = 0
    API_FORMAT_OPENAI = 1
    API_FORMAT_ANTHROPIC = 2
    API_FORMAT_GEMINI = 3
  }

  class AccountConfig <<message>> {
    + id : string
    + format : ApiFormat
    + base_url : string
    + secret_ref : string
    + default_model : string
    .. oneof options ..
    + openai : OpenAiOptions
    + anthropic : AnthropicOptions
    + gemini : GeminiOptions
  }

  class OpenAiOptions <<message>> {
    + organization : optional string
  }

  class AnthropicOptions <<message>> {
    + api_version : string
    + default_max_tokens : int32
  }

  class GeminiOptions <<message>> {
    + api_version : string
  }

  class LlmRequest <<message>> {
    + model : string
    + system : string
    + messages : repeated Message
    + tools : repeated ToolDefinition
    + max_tokens : optional int32
  }

  class LlmResponse <<message>> {
    + content : repeated ContentBlock
    + stop_reason : StopReason
    + usage : Usage
  }

  class LlmDelta <<message>> {
    + index : int32
    .. oneof delta ..
    + text : string
    + tool_call : ToolCallDelta
  }

  class GenerateRequest <<message>> {
    + account_id : string
    + request : LlmRequest
  }

  class GenerateEvent <<message>> {
    .. oneof event ..
    + delta : LlmDelta
    + response : LlmResponse
  }
}

package "agent.proto (gRPC services, generated base classes)" as rpc {
  class "AccountService::Service" as AccountServiceBase <<gRPC>> {
    + CreateAccount(CreateAccountRequest) : AccountConfig
    + GetAccount(GetAccountRequest) : AccountConfig
    + ListAccounts(ListAccountsRequest) : ListAccountsResponse
    + DeleteAccount(DeleteAccountRequest) : google.protobuf.Empty
  }

  class "AgentService::Service" as AgentServiceBase <<gRPC>> {
    + Generate(GenerateRequest) : stream GenerateEvent
  }
}

package "Server" as server {
  class AccountServiceImpl {
    - accounts_ : AccountManager*
    + CreateAccount(context : grpc::ServerContext*, request : const CreateAccountRequest*, response : AccountConfig*) : grpc::Status
    + GetAccount(context : grpc::ServerContext*, request : const GetAccountRequest*, response : AccountConfig*) : grpc::Status
    + ListAccounts(context : grpc::ServerContext*, request : const ListAccountsRequest*, response : ListAccountsResponse*) : grpc::Status
    + DeleteAccount(context : grpc::ServerContext*, request : const DeleteAccountRequest*, response : google::protobuf::Empty*) : grpc::Status
  }

  class AgentServiceImpl {
    - agent_ : Agent*
    + Generate(context : grpc::ServerContext*, request : const GenerateRequest*, writer : grpc::ServerWriter<GenerateEvent>*) : grpc::Status
  }
}

package "Core" as core {
  class Agent {
    - accounts_ : AccountManager*
    - http_client_ : HttpClient*
    + Generate(request : const GenerateRequest&, on_delta : absl::FunctionRef<absl::Status(const LlmDelta&)>) : absl::StatusOr<LlmResponse>
  }

  class AccountManager {
    - mu_ : absl::Mutex
    - factories_ : absl::flat_hash_map<ApiFormat, std::unique_ptr<AccountFactory>>
    - accounts_ : absl::flat_hash_map<std::string, std::shared_ptr<const Account>>
    + RegisterFactory(format : ApiFormat, factory : std::unique_ptr<AccountFactory>) : absl::Status
    + Load(config : const AccountConfig&) : absl::StatusOr<std::shared_ptr<const Account>>
    + Get(id : absl::string_view) : absl::StatusOr<std::shared_ptr<const Account>>
    + List() : std::vector<std::shared_ptr<const Account>>
    + Remove(id : absl::string_view) : absl::Status
  }

  interface SecretStore {
    + {abstract} Resolve(secret_ref : absl::string_view) : absl::StatusOr<SecretString>
  }

  interface HttpClient {
    + {abstract} Send(request : const HttpRequest&) : absl::StatusOr<HttpResponse>
    + {abstract} SendStream(request : const HttpRequest&, on_chunk : absl::FunctionRef<absl::Status(absl::string_view)>) : absl::Status
  }
}

package "Factories" as factories {
  abstract class AccountFactory {
    - secrets_ : SecretStore*
    + Create(config : const AccountConfig&) : absl::StatusOr<std::unique_ptr<Account>>
    - Validate(config : const AccountConfig&) : absl::Status
    - {abstract} CreateAccount(config : const AccountConfig&, api_key : SecretString) : std::unique_ptr<Account>
  }

  class OpenAiAccountFactory {
    - Validate(config : const AccountConfig&) : absl::Status
    - CreateAccount(config : const AccountConfig&, api_key : SecretString) : std::unique_ptr<Account>
  }

  class AnthropicAccountFactory {
    - Validate(config : const AccountConfig&) : absl::Status
    - CreateAccount(config : const AccountConfig&, api_key : SecretString) : std::unique_ptr<Account>
  }

  class GeminiAccountFactory {
    - Validate(config : const AccountConfig&) : absl::Status
    - CreateAccount(config : const AccountConfig&, api_key : SecretString) : std::unique_ptr<Account>
  }
}

package "Accounts (provider wire formats over HTTP)" as accounts {
  abstract class Account {
    - config_ : AccountConfig
    - api_key_ : SecretString
    + config() : const AccountConfig&
    + {abstract} BuildRequest(request : const LlmRequest&) : absl::StatusOr<HttpRequest>
    + {abstract} ParseResponse(response : const HttpResponse&) : absl::StatusOr<LlmResponse>
    + {abstract} CreateStreamParser() : std::unique_ptr<StreamParser>
    # api_key() : const SecretString&
  }

  class OpenAiAccount
  class AnthropicAccount
  class GeminiAccount

  interface StreamParser {
    + {abstract} Parse(chunk : absl::string_view) : absl::StatusOr<std::vector<LlmDelta>>
    + {abstract} Finish() : absl::StatusOr<LlmResponse>
  }

  class OpenAiStreamParser
  class AnthropicStreamParser
  class GeminiStreamParser
}

AccountServiceBase <|-- AccountServiceImpl
AgentServiceBase <|-- AgentServiceImpl
AccountServiceImpl --> AccountManager
AgentServiceImpl --> Agent

Agent --> AccountManager : gets accounts from
Agent --> HttpClient : calls providers with
Agent ..> StreamParser : one per Generate call
AccountManager *-- "0..*" AccountFactory : registers by format
AccountManager o-- "0..*" Account : shares ownership of

AccountFactory <|-- OpenAiAccountFactory
AccountFactory <|-- AnthropicAccountFactory
AccountFactory <|-- GeminiAccountFactory
AccountFactory --> SecretStore : resolves API key with
AccountFactory ..> AccountConfig : reads

Account <|-- OpenAiAccount
Account <|-- AnthropicAccount
Account <|-- GeminiAccount

StreamParser <|.. OpenAiStreamParser
StreamParser <|.. AnthropicStreamParser
StreamParser <|.. GeminiStreamParser

OpenAiAccountFactory ..> OpenAiAccount : <<creates>>
AnthropicAccountFactory ..> AnthropicAccount : <<creates>>
GeminiAccountFactory ..> GeminiAccount : <<creates>>

OpenAiAccount ..> OpenAiStreamParser : <<creates>>
AnthropicAccount ..> AnthropicStreamParser : <<creates>>
GeminiAccount ..> GeminiStreamParser : <<creates>>

AccountConfig --> ApiFormat
AccountConfig *-- OpenAiOptions
AccountConfig *-- AnthropicOptions
AccountConfig *-- GeminiOptions
GenerateRequest *-- LlmRequest
GenerateEvent *-- LlmDelta
GenerateEvent *-- LlmResponse
Account ..> LlmRequest : encodes
Account ..> LlmResponse : decodes
StreamParser ..> LlmDelta : decodes

note right of AccountFactory
  Create() is non-virtual; Validate() is virtual
  with a default implementation:
  1. Validate(config)
  2. secrets_->Resolve(config.secret_ref())
  3. CreateAccount(config, std::move(api_key))
  Subclasses reject an options oneof
  that does not match config.format().
end note

note bottom of Account
  All public methods are const.
  Instances are immutable after creation.
  Streaming state lives in StreamParser.
end note

note bottom of AccountServiceImpl
  Service handlers convert absl::Status to grpc::Status.
  RPCs return secret_ref only, never the API key.
end note

@enduml
