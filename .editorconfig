root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,proto}]
max_line_length = 80

[{CMakeLists.txt,*.cmake}]
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
